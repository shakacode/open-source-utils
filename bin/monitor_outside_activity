#!/usr/bin/env ruby
# frozen_string_literal: true

require "cgi"
require "base64"
require "fileutils"
require "json"
require "net/http"
require "open3"
require "set"
require "time"
require "tempfile"
require "uri"
require "yaml"

require_relative "../lib/open_source_utils/monitor_support"

ROOT = File.expand_path(ENV.fetch("OSS_MONITOR_WORKSPACE", File.expand_path("..", __dir__)))
STATE_PATH = File.join(ROOT, ".Codex", "oss-outside-activity-monitor-state.json")
RESULT_PATH = File.join(ROOT, ".Codex", "oss-outside-activity-monitor-result.json")
SLACK_WEBHOOK_PATH = File.expand_path("~/.codex/codex_slack_webhook_url")
ORG = "shakacode"
TEAM = "shakacode"
TRUSTED_REPO = "react_on_rails"
TRUSTED_EXPR = "main:.agents/shaka/trusted-github-actors.yml"
TRUSTED_FILE_PATH = ".agents/shaka/trusted-github-actors.yml"
TIMEOUT = "/opt/homebrew/bin/timeout"
GH_TIMEOUT_SECONDS = "20"
MAX_RETRIES = 3
RETRY_DELAYS = [1, 2, 4]
FIRST_RUN_DAYS = 60
OVERLAP_SECONDS = 5 * 60
REPORT_RETENTION_DAYS = 120
ACTIVE_REPO_DAYS = Integer(ENV.fetch("MONITOR_ACTIVE_REPO_DAYS", "365"))
MAX_GITHUB_API_REQUESTS = [Integer(ENV.fetch("MONITOR_MAX_API_REQUESTS", "600")), 600].min
HST_OFFSET = "-10:00"
REQUEST_BUDGET = OpenSourceUtils::RequestBudget.new(MAX_GITHUB_API_REQUESTS)
STANDARD_OUTSIDE_REASON = "not in ShakaCode team allowlist or trusted actors file; actor type %<type>s."

def with_retries
  attempts = 0
  begin
    yield
  rescue OpenSourceUtils::RequestBudgetExceeded
    raise
  rescue StandardError => e
    attempts += 1
    raise e if attempts >= MAX_RETRIES || OpenSourceUtils::MonitorSupport.rate_limit_error?(e.message)

    sleep(RETRY_DELAYS[[attempts - 1, RETRY_DELAYS.length - 1].min])
    retry
  end
end

def gh_json(*args)
  with_retries do
    REQUEST_BUDGET.consume!
    stdout, stderr, status = Open3.capture3(TIMEOUT, GH_TIMEOUT_SECONDS, "gh", "api", *args)
    unless status.success?
      error_message = stderr.to_s.strip
      error_message = stdout.to_s.strip if error_message.empty?
      raise "gh api #{args.join(" ")} failed: #{error_message} (exit=#{status.exitstatus})"
    end

    JSON.parse(stdout)
  end
end

def paged_array(path, stop_when: nil)
  OpenSourceUtils::MonitorSupport.paged_array(path, fetcher: method(:gh_json), stop_when: stop_when)
end

def graphql_query(query, variables = {})
  normalized_query = query.to_s.gsub(/\s+/, " ").strip
  args = ["graphql", "-f", "query=#{normalized_query}"]
  variables.each do |key, value|
    args << "-f" << "#{key}=#{value}"
  end
  data = gh_json(*args)
  raise "GraphQL errors: #{data['errors'].to_json}" if data['errors']&.any?
  data
end

def parse_time(value)
  Time.parse(value.to_s).utc
rescue StandardError
  nil
end

def gq(value)
  JSON.generate(value.to_s)[1...-1]
end

def actor_login(actor)
  (actor || {})["login"].to_s
end

def actor_type(actor)
  ((actor || {})["type"] || (actor || {})["__typename"]).to_s
end

def outside_because(actor)
  format(STANDARD_OUTSIDE_REASON, type: actor_type(actor))
end

def bot_actor?(login, type)
  type.to_s.casecmp("bot").zero? || login.to_s.downcase.end_with?("[bot]")
end

def outside_actor?(actor, trusted)
  login = actor_login(actor)
  return false if login.empty?

  normalized = login.downcase
  return false if trusted.include?(normalized)
  return false if bot_actor?(login, actor_type(actor))

  true
end

def format_hst(time)
  time.getlocal(HST_OFFSET).strftime("%Y-%m-%d %H:%M:%S") + " HST"
end

def add_item(items, reported_ids, id:, repository:, activity_type:, actor:, link:, summary:, outside_because:, action:)
  return if reported_ids.include?(id)
  return if link.to_s.empty?

  items << {
    id: id,
    repository: repository,
    activity_type: activity_type,
    author: actor_login(actor),
    actor_type: actor_type(actor),
    link: link,
    summary: summary.to_s.strip[0, 240],
    outside_because: outside_because,
    suggested_next_action: action
  }
end

def parse_login(value)
  value.to_s.downcase.strip
end

def read_state
  return {} unless File.exist?(STATE_PATH)

  JSON.parse(File.read(STATE_PATH))
rescue JSON::ParserError => e
  raise "Monitor state is invalid at #{STATE_PATH}: #{e.message}"
end

def safe_write(path, payload)
  FileUtils.mkdir_p(File.dirname(path))
Tempfile.create([".oss-monitor-", ".json"], File.dirname(path)) do |file|
  file.write(JSON.pretty_generate(payload) + "\n")
  file.flush
  file.fsync
  File.rename(file.path, path)
end
end

def compute_window(state)
  started_at = Time.now.utc
  last_successful = parse_time(state["last_successful_run_at"])
  start_time = last_successful ? last_successful - OVERLAP_SECONDS : started_at - (FIRST_RUN_DAYS * 24 * 60 * 60)
  [start_time, started_at]
end

def parse_yaml_values(value)
  return [] unless value

  if value.is_a?(Array)
    value.flat_map { |v| parse_yaml_values(v) }
  elsif value.is_a?(Hash)
    value.values.flat_map { |v| parse_yaml_values(v) }
  else
    [value.to_s]
  end
end

def normalize_reported_records(state, now)
  cutoff = now - (REPORT_RETENTION_DAYS * 24 * 60 * 60)
  seen = parse_time(state["last_successful_run_at"]) || cutoff
  raw = Array(state["last_reported_activity_ids"])

  records = {}
  raw.each do |entry|
    if entry.is_a?(Hash)
      id = entry["id"].to_s
      seen_at = parse_time(entry["seen_at"]) || seen
    else
      id = entry.to_s
      seen_at = seen
    end
    next if id.empty? || seen_at < cutoff
    records[id] = seen_at
  end

  records
end

def fetch_team_members(team = TEAM)
  members = []
  query = <<~GRAPHQL
    query($org:String!,$team:String!,$after:String){
      organization(login:$org){
        team(slug:$team){
          members(first:100, after:$after){
            nodes{login}
            pageInfo{hasNextPage endCursor}
          }
        }
      }
    }
  GRAPHQL

  cursor = nil
  loop do
    data = graphql_query(query, { "org" => ORG, "team" => team, "after" => cursor }.compact)
    nodes = data.dig("data", "organization", "team", "members")
    raise "team membership data missing" unless nodes

    Array(nodes["nodes"]).each { |member| members << parse_login(member["login"]) }
    break unless nodes.dig("pageInfo", "hasNextPage")
    cursor = nodes.dig("pageInfo", "endCursor")
  end

  members.reject(&:empty?).uniq
rescue StandardError => e
  raise if e.is_a?(OpenSourceUtils::RequestBudgetExceeded) || OpenSourceUtils::MonitorSupport.rate_limit_error?(e.message)
  paged_array("/orgs/#{ORG}/teams/#{team}/members").map { |member| parse_login(member["login"]) }
end

def fetch_trusted_actors
  text = fetch_trusted_actors_graphql
  text = fetch_trusted_actors_rest if text.to_s.strip.empty?
  text = fetch_trusted_actors_raw if text.to_s.strip.empty?
  raise "trusted actors file unavailable or empty: #{ORG}/#{TRUSTED_REPO}/#{TRUSTED_FILE_PATH} (ref main)" if text.to_s.strip.empty?

  parsed = YAML.safe_load(text, aliases: true)
  raise "trusted actors file content could not be parsed" unless parsed.is_a?(Hash) || parsed.is_a?(Array)

  users = parsed.is_a?(Hash) ? Array(parsed["trusted_users"]).map { |v| parse_login(v) }.reject(&:empty?) : []
  bots = parsed.is_a?(Hash) ? Array(parsed["trusted_bots"]).map { |v| parse_login(v) }.reject(&:empty?) : []
  metadata_bots = parsed.is_a?(Hash) ? Array(parsed["trusted_metadata_bots"]).map { |v| parse_login(v) }.reject(&:empty?) : []
  teams = parsed.is_a?(Hash) ? Array(parsed["trusted_teams"]).map { |v| parse_login(v) }.reject(&:empty?) : []
  extras = parsed.is_a?(Hash) ? parse_yaml_values(parsed["trusted_actors"]) : parse_yaml_values(parsed)
  extras = extras.map { |v| parse_login(v) }.reject(&:empty?)

  all = (users + extras).map { |v| parse_login(v) }.reject(&:empty?).uniq

  {
    users: users,
    bots: bots,
    metadata_bots: metadata_bots,
    teams: teams,
    trusted: all,
    counts: {
      users: users.length,
      bots: bots.length,
      metadata_bots: metadata_bots.length,
      teams: teams.length,
      trusted_unique: all.length
    }
  }
end

def fetch_trusted_actors_graphql
  query = <<~GRAPHQL
    query {
      repository(owner: "#{ORG}", name: "#{TRUSTED_REPO}") {
        object(expression: "#{TRUSTED_EXPR}") {
          ... on Blob {
            text
          }
        }
      }
    }
  GRAPHQL

  data = graphql_query(query)
  data.dig("data", "repository", "object", "text").to_s
rescue StandardError => e
  raise if e.is_a?(OpenSourceUtils::RequestBudgetExceeded) || OpenSourceUtils::MonitorSupport.rate_limit_error?(e.message)
  nil
end

def fetch_trusted_actors_rest
  payload = gh_json("/repos/#{ORG}/#{TRUSTED_REPO}/contents/#{TRUSTED_FILE_PATH}?ref=main")
  return nil if !payload.is_a?(Hash) || payload["encoding"].to_s != "base64" || payload["content"].to_s.strip.empty?

  Base64.decode64(payload["content"].to_s.delete(" \n\r\t")).strip
rescue StandardError => e
  raise if e.is_a?(OpenSourceUtils::RequestBudgetExceeded) || OpenSourceUtils::MonitorSupport.rate_limit_error?(e.message)
  nil
end

def fetch_trusted_actors_raw
  payload = gh_json("/repos/#{ORG}/#{TRUSTED_REPO}/contents/#{TRUSTED_FILE_PATH}?ref=main")
  raw_url = payload.is_a?(Hash) ? payload["download_url"].to_s : ""
  return nil if raw_url.empty?

  uri = URI(raw_url)
  REQUEST_BUDGET.consume!
  response = Net::HTTP.get_response(uri)
  raise "GitHub raw HTTP 429 rate limit" if response.code.to_i == 429
  return nil unless response.is_a?(Net::HTTPSuccess)

  response.body.to_s.strip
rescue StandardError => e
  raise if e.is_a?(OpenSourceUtils::RequestBudgetExceeded) || OpenSourceUtils::MonitorSupport.rate_limit_error?(e.message)
  nil
end

def post_slack(text)
  webhook = ENV["CODEX_SLACK_WEBHOOK_URL"]
  webhook = File.read(SLACK_WEBHOOK_PATH).strip if webhook.to_s.empty? && File.exist?(SLACK_WEBHOOK_PATH)
  raise "Slack webhook missing" if webhook.to_s.empty?

  uri = URI(webhook)
  response = Net::HTTP.post(uri, JSON.generate({ text: text }), { "Content-Type" => "application/json" })
  raise "Slack returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  true
end

def build_blocked_message(blockers, start_time, end_time)
  lines = [
    "*Outside GitHub activity monitor blocked*",
    "Window: #{format_hst(start_time)} to #{format_hst(end_time)}",
    "",
    "*Blocking sources:*"
  ]
  blockers.each { |source| lines << "- #{source}" }
  lines << ""
  lines << "*Next step:* Fix GitHub access/scopes or the network path, then rerun the monitor."
  lines.join("\n")
end

def build_activity_message(items, start_time, end_time)
  sentence = lambda do |text|
    text = text.to_s.strip
    text.match?(/[.!?]\z/) ? text : "#{text}."
  end

  lines = [
    "*Outside GitHub activity detected*",
    "Window: #{format_hst(start_time)} to #{format_hst(end_time)}",
    "*Items:* #{items.length}",
    ""
  ]

  items.each_with_index do |item, index|
    title = item[:summary].to_s.strip
    title = "#{title[0, 87].rstrip}..." if title.length > 90
    title = title.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;").gsub("|", "¦")

    lines << "- #{item[:repository]} · #{item[:activity_type]} · <#{item[:link]}|#{title}> — author: #{item[:author]}"
    lines << "  Outside because: #{sentence.call(item[:outside_because])}"
    lines << "  Suggested action: #{sentence.call(item[:suggested_next_action])}"
    lines << "" unless index == items.length - 1
  end
  lines.join("\n")
end

def collect_issues(owner, repo, full_name, start_time, trusted, reported_ids, items)
  encoded = CGI.escape(repo)
  issues = paged_array("/repos/#{owner}/#{encoded}/issues?state=all&since=#{CGI.escape(start_time.iso8601)}")

  issues.each do |issue|
    next if issue["pull_request"]

    next unless (created = parse_time(issue["created_at"])) && created >= start_time
    next unless outside_actor?(issue["user"], trusted)

    add_item(
      items,
      reported_ids,
      id: "issue:#{issue.fetch("node_id", "#{full_name}:issue:#{issue.fetch("number")}")}",
      repository: full_name,
      activity_type: "new issue",
      actor: issue["user"],
      link: issue["html_url"],
      summary: "Issue ##{issue["number"]}: #{issue["title"]}",
      outside_because: outside_because(issue["user"]),
      action: "Triage the issue and decide whether to respond, label, or close."
    )
  end
end

def collect_issue_comments(owner, repo, full_name, start_time, trusted, reported_ids, items, issue_cache)
  encoded = CGI.escape(repo)
  comments = paged_array("/repos/#{owner}/#{encoded}/issues/comments?since=#{CGI.escape(start_time.iso8601)}")

  comments.each do |comment|
    next unless (created = parse_time(comment["created_at"])) && created >= start_time
    next unless outside_actor?(comment["user"], trusted)

    issue_number = comment.fetch("issue_url", "").to_s.split("/").last
    cache_key = "#{full_name}:#{issue_number}"
    issue = issue_cache[cache_key]
    unless issue
      issue = gh_json("/repos/#{owner}/#{encoded}/issues/#{issue_number}")
      issue_cache[cache_key] = issue
    end

    target_type = issue && issue["pull_request"] ? "new pull request issue comment" : "new issue comment"
    title = issue.to_h["title"] || "Unknown"

    add_item(
      items,
      reported_ids,
      id: "issue_comment:#{comment.fetch("node_id", "#{full_name}:comment:#{comment.fetch("id")}")}",
      repository: full_name,
      activity_type: target_type,
      actor: comment["user"],
      link: comment["html_url"],
      summary: "Comment on ##{issue_number}: #{title}",
      outside_because: outside_because(comment["user"]),
      action: "Review the comment and reply or route it to the repository maintainer."
    )
  end
end

def collect_pr_reviews(owner, repo, pr_number, title, start_time, trusted, reported_ids, items, reviews: nil)
  encoded = CGI.escape(repo)
  reviews ||= paged_array("/repos/#{owner}/#{encoded}/pulls/#{pr_number}/reviews")

  reviews.each do |review|
    next unless (submitted = parse_time(review["submitted_at"])) && submitted >= start_time

    review_state = review["state"].to_s
    next unless %w[COMMENTED APPROVED CHANGES_REQUESTED DISMISSED].include?(review_state)
    next unless outside_actor?(review["user"], trusted)

    activity_type = review_state == "CHANGES_REQUESTED" ? "requested changes" : "new pull request review"
    add_item(
      items,
      reported_ids,
      id: "pull_review:#{review.fetch("node_id", "#{owner}/#{repo}/review:#{review.fetch("id")}")}",
      repository: "#{owner}/#{repo}",
      activity_type: activity_type,
      actor: review["user"],
      link: review["html_url"] || "https://github.com/#{owner}/#{repo}/pull/#{pr_number}",
      summary: "Review #{review_state} on PR ##{pr_number}: #{title}",
        outside_because: outside_because(review["user"]),
      action: review_state == "CHANGES_REQUESTED" ? "Assess the requested changes and decide whether to respond or update the PR." : "Read the review and decide whether a maintainer response is needed."
    )
  end
end

def collect_graphql_reviews(owner, repo, pr, connection, start_time, trusted, reported_ids, items)
  reviews = connection.fetch("nodes").map do |review|
    { "node_id" => review["id"], "id" => review["id"], "state" => review["state"],
      "submitted_at" => review["submittedAt"], "html_url" => review["url"], "user" => review["author"] }
  end
  collect_pr_reviews(owner, repo, pr["number"], pr["title"], start_time, trusted, reported_ids, items, reviews: reviews)
end

def collect_pull_requests(owner, repo, full_name, start_time, trusted, reported_ids, items)
  after = nil
  loop do
    # Enumerate every PR: review submission time is independent of PR creation time.
    # Batch reviews with PRs so the minimum scan still costs one request per repo.
    query = <<~GRAPHQL
      query {
        repository(owner:"#{gq(owner)}",name:"#{gq(repo)}") {
          pullRequests(first:100#{", after: \"#{gq(after)}\"" if after}, orderBy:{field:CREATED_AT,direction:DESC}) {
            nodes {
              id number title url createdAt author { login __typename }
              reviews(first:10) {
                nodes { id state submittedAt url author { login __typename } }
                pageInfo { hasNextPage endCursor }
              }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    GRAPHQL
    connection = graphql_query(query).dig("data", "repository", "pullRequests")
    raise "pull request data missing for #{full_name}" unless connection

    Array(connection["nodes"]).each do |pr|
      actor = pr["author"]
      if (created = parse_time(pr["createdAt"])) && created >= start_time && outside_actor?(actor, trusted)
        add_item(items, reported_ids,
          id: "pull_request:#{pr.fetch('id')}", repository: full_name,
          activity_type: "new pull request", actor: actor, link: pr["url"],
          summary: "PR ##{pr['number']}: #{pr['title']}", outside_because: outside_because(actor),
          action: "Review the PR for maintainability and assign an internal owner.")
      end

      reviews = pr.fetch("reviews")
      collect_graphql_reviews(owner, repo, pr, reviews, start_time, trusted, reported_ids, items)
    end
    pending = connection.fetch("nodes").select { |pr| pr.dig("reviews", "pageInfo", "hasNextPage") }
    until pending.empty?
      batch = pending.shift(10)
      fields = batch.each_with_index.map do |pr, index|
        <<~GRAPHQL
          pr#{index}: node(id:"#{gq(pr.fetch('id'))}") { ... on PullRequest {
            reviews(first:100, after:"#{gq(pr.dig('reviews', 'pageInfo', 'endCursor'))}") {
              nodes { id state submittedAt url author { login __typename } }
              pageInfo { hasNextPage endCursor }
            }
          } }
        GRAPHQL
      end.join(" ")
      data = graphql_query("query { #{fields} }").fetch("data")
      batch.each_with_index do |pr, index|
        reviews = data.dig("pr#{index}", "reviews")
        raise "Review data missing for #{full_name} PR #{pr['number']}" unless reviews
        collect_graphql_reviews(owner, repo, pr, reviews, start_time, trusted, reported_ids, items)
        pr["reviews"] = reviews
        pending << pr if reviews.dig("pageInfo", "hasNextPage")
      end
    end
    break unless connection.dig("pageInfo", "hasNextPage")
    after = connection.dig("pageInfo", "endCursor")
  end
end

def collect_pull_review_comments(owner, repo, full_name, start_time, trusted, reported_ids, items)
  encoded = CGI.escape(repo)
  comments = paged_array("/repos/#{owner}/#{encoded}/pulls/comments?since=#{CGI.escape(start_time.iso8601)}")

  comments.each do |comment|
    next unless (created = parse_time(comment["created_at"])) && created >= start_time
    next unless outside_actor?(comment["user"], trusted)

    add_item(
      items,
      reported_ids,
      id: "pull_review_comment:#{comment.fetch("node_id", "#{full_name}:comment:#{comment.fetch("id")}")}",
      repository: full_name,
      activity_type: "new pull request review comment",
      actor: comment["user"],
      link: comment["html_url"],
      summary: "Review comment on #{comment["path"]}",
      outside_because: outside_because(comment["user"]),
      action: "Review the code comment and decide whether a maintainer response or patch is needed."
    )
  end
end

def collect_discussion_comment(owner, repo, number, title, comment, start_time, trusted, reported_ids, items)
  if (created = parse_time(comment["createdAt"])) && created >= start_time && outside_actor?(comment["author"], trusted)
    add_item(items, reported_ids, id: "discussion_comment:#{comment.fetch('id')}",
      repository: "#{owner}/#{repo}", activity_type: "new GitHub Discussion comment",
      actor: comment["author"], link: comment["url"], summary: "Discussion comment on ##{number}: #{title}",
      outside_because: outside_because(comment["author"]),
      action: "Review the discussion comment and decide whether a maintainer response is needed.")
  end
  replies = comment["replies"]
  return unless replies

  loop do
    replies.fetch("nodes").each do |reply|
      collect_discussion_comment(owner, repo, number, title, reply, start_time, trusted, reported_ids, items)
    end
    break unless replies.dig("pageInfo", "hasNextPage")

    query = <<~GRAPHQL
      query { node(id:"#{gq(comment.fetch('id'))}") { ... on DiscussionComment {
        replies(first:100, after:"#{gq(replies.dig('pageInfo', 'endCursor'))}") {
          nodes { id url createdAt author { login __typename } }
          pageInfo { hasNextPage endCursor }
        }
      } } }
    GRAPHQL
    replies = graphql_query(query).dig("data", "node", "replies")
    raise "Discussion replies missing for #{comment['id']}" unless replies
  end
end

def collect_discussion_comments(owner, repo, discussion_number, title, start_time, trusted, reported_ids, items, after = nil)
  loop do
    query = <<~GRAPHQL
      query{
        repository(owner:"#{gq(owner)}",name:"#{gq(repo)}"){
          discussion(number:#{discussion_number}){
            comments(first:100#{", after: \"#{gq(after)}\"" if after}){
              nodes{id url createdAt author{login __typename} replies(first:100){nodes{id url createdAt author{login __typename}} pageInfo{hasNextPage endCursor}}}
              pageInfo{hasNextPage endCursor}
            }
          }
        }
      }
    GRAPHQL

    data = graphql_query(query)
    comment_connection = data.dig("data", "repository", "discussion", "comments")
    break unless comment_connection

    Array(comment_connection["nodes"]).each do |comment|
      collect_discussion_comment(owner, repo, discussion_number, title, comment, start_time, trusted, reported_ids, items)
    end

    break unless comment_connection.dig("pageInfo", "hasNextPage")
    after = comment_connection.dig("pageInfo", "endCursor")
  end
end

def collect_discussions(owner, repo, start_time, trusted, reported_ids, items)
  after = nil
  loop do
    query = <<~GRAPHQL
      query{
        repository(owner:"#{gq(owner)}",name:"#{gq(repo)}"){
          hasDiscussionsEnabled
          discussions(first:20#{", after: \"#{gq(after)}\"" if after}, orderBy:{field:UPDATED_AT,direction:DESC}){
            nodes{
              id number title url createdAt updatedAt author{login __typename}
              comments(first:100){nodes{id url createdAt author{login __typename} replies(first:100){nodes{id url createdAt author{login __typename}} pageInfo{hasNextPage endCursor}}} pageInfo{hasNextPage endCursor}}
            }
            pageInfo{hasNextPage endCursor}
          }
        }
      }
    GRAPHQL

    data = graphql_query(query)
    repository = data.dig("data", "repository")
    break unless repository
    break unless repository["hasDiscussionsEnabled"]

    discussions = Array(repository.dig("discussions", "nodes"))
    discussions.each do |discussion|

      actor = discussion["author"]

      if (created = parse_time(discussion["createdAt"])) && created >= start_time && outside_actor?(actor, trusted)
        add_item(
          items,
          reported_ids,
          id: "discussion:#{discussion["id"]}",
          repository: "#{owner}/#{repo}",
          activity_type: "new GitHub Discussion",
          actor: actor,
          link: discussion["url"],
          summary: "Discussion ##{discussion["number"]}: #{discussion["title"]}",
          outside_because: outside_because(actor),
          action: "Review the discussion and decide whether to answer or convert to an issue."
        )
      end

      if discussion.dig("comments", "pageInfo", "hasNextPage")
        collect_discussion_comments(
          owner,
          repo,
          discussion["number"],
          discussion["title"],
          start_time,
          trusted,
          reported_ids,
          items,
          discussion.dig("comments", "pageInfo", "endCursor")
        )
      end

  Array(discussion.dig("comments", "nodes")).each do |comment|
    collect_discussion_comment(owner, repo, discussion["number"], discussion["title"], comment, start_time, trusted, reported_ids, items)
  end
end

    break unless repository.dig("discussions", "pageInfo", "hasNextPage")
    after = repository.dig("discussions", "pageInfo", "endCursor")
  end
end

def run
  repo_filter = ENV['MONITOR_REPO'].to_s.strip
  diagnostic = !repo_filter.empty? || ENV['MONITOR_DRY_RUN'] == '1'
  state_error = nil
  state = begin
    read_state
  rescue StandardError => e
    state_error = e.message
    {}
  end
  state_read = File.exist?(STATE_PATH)
  start_time, ended_at = compute_window(state)
  activity_cutoff = ended_at - (ACTIVE_REPO_DAYS * 24 * 60 * 60)
  reported_records = normalize_reported_records(state, ended_at)
  reported_ids = reported_records.keys.to_set

  blockers = state_error ? [state_error] : []
  team_members = []
  trusted_payload = {
    users: [],
    bots: [],
    metadata_bots: [],
    teams: [],
    counts: { users: 0, bots: 0, metadata_bots: 0, teams: 0, trusted_unique: 0 },
    trusted: []
  }
  trusted = Set.new

  begin
    team_members = fetch_team_members
    trusted_payload = fetch_trusted_actors
    additional_members = trusted_payload.fetch(:teams, []).reject { |team| team == TEAM }.flat_map { |team| fetch_team_members(team) }
    trusted = (team_members + additional_members + trusted_payload.fetch(:trusted, [])).uniq.to_set
  rescue StandardError => e
    blockers << "allowlist refresh failed: #{e.message}"
  end

  repos = []
  discovered_repos = []
  minimum_scan_requests = 0
  items = []
  issue_cache = {}
  state_updated = false
  slack_error = nil
  slack_sent = false

  if blockers.empty?
    begin
      discovered_repos = paged_array("/orgs/#{ORG}/repos?type=public").select do |repo|
        !repo["private"] && !repo["archived"] && !repo["disabled"]
      end

      if !repo_filter.empty?
        repos = discovered_repos.select { |repo| repo.fetch("full_name", "") == repo_filter }
      else
        repos = discovered_repos.select do |repo|
          OpenSourceUtils::MonitorSupport.active_repository?(repo, activity_cutoff)
        end
      end

      raise "No eligible public repository matches MONITOR_REPO=#{repo_filter}" if !repo_filter.empty? && repos.empty?

      minimum_scan_requests = OpenSourceUtils::MonitorSupport.minimum_scan_requests(repos)
      REQUEST_BUDGET.ensure_capacity!(minimum_scan_requests)

      repos.each_with_index do |repo, index|
        name = repo.fetch("name")
        full_name = repo.fetch("full_name")
        warn "scanning #{index + 1}/#{repos.length} #{full_name}"

        collect_issues(ORG, name, full_name, start_time, trusted, reported_ids, items)
        collect_issue_comments(ORG, name, full_name, start_time, trusted, reported_ids, items, issue_cache)
        collect_pull_requests(ORG, name, full_name, start_time, trusted, reported_ids, items)
        collect_pull_review_comments(ORG, name, full_name, start_time, trusted, reported_ids, items)
        collect_discussions(ORG, name, start_time, trusted, reported_ids, items) if repo["has_discussions"]
      end
    rescue StandardError => e
      blockers << "scan failed: #{e.message}"
    end
  end

  items.sort_by! { |item| [item[:repository], item[:activity_type], item[:author], item[:summary]] }

  if !diagnostic && blockers.empty? && items.any?
    begin
      post_slack(build_activity_message(items, start_time, ended_at))
      slack_sent = true
    rescue StandardError => e
      slack_error = e.message
    end
  end

  if !diagnostic && blockers.empty? && (items.empty? || slack_sent)
    cutoff = ended_at - (REPORT_RETENTION_DAYS * 24 * 60 * 60)
    updated_records = reported_records.dup
    items.each { |item| updated_records[item[:id]] = ended_at }
    updated_records = updated_records.select { |_, seen_at| seen_at >= cutoff }

    state_payload = {
      last_successful_run_at: ended_at.iso8601,
      repository_count: repos.length,
      discovered_repository_count: discovered_repos.length,
      repository_activity_cutoff: activity_cutoff.iso8601,
      api_requests_used: REQUEST_BUDGET.used,
      api_request_budget: REQUEST_BUDGET.limit,
      minimum_scan_requests: minimum_scan_requests,
      team_count: team_members.length,
      trusted_users: trusted_payload.fetch(:counts, {})["users"] || trusted_payload.fetch(:counts, {})[:users],
      trusted_bots: trusted_payload.fetch(:counts, {})["bots"] || trusted_payload.fetch(:counts, {})[:bots],
      trusted_metadata_bots: trusted_payload.fetch(:counts, {})["metadata_bots"] || trusted_payload.fetch(:counts, {})[:metadata_bots],
      trusted_teams: trusted_payload.fetch(:counts, {})["teams"] || trusted_payload.fetch(:counts, {})[:teams],
      trusted_unique: trusted.length,
      allowlist_refresh_status: "ok",
      run_status: items.empty? ? "no_outside_activity" : "outside_activity_reported",
      last_reported_activity_ids: updated_records.map { |id, seen_at| { id: id, seen_at: seen_at.iso8601 } }
    }
    safe_write(STATE_PATH, state_payload)
    state_updated = true
  end

  result = {
    scan_window: {
      start_utc: start_time.iso8601,
      end_utc: ended_at.iso8601,
      start_hst: format_hst(start_time),
      end_hst: format_hst(ended_at)
    },
    repository_count: repos.length,
    discovered_repository_count: discovered_repos.length,
    repository_activity_cutoff: activity_cutoff.iso8601,
    discussions_repository_count: repos.count { |repo| repo["has_discussions"] },
    api_requests: {
      used: REQUEST_BUDGET.used,
      budget: REQUEST_BUDGET.limit,
      minimum_scan_requests: minimum_scan_requests
    },
    allowlists: {
      team_members: team_members.length,
      trusted_users: trusted_payload.fetch(:counts, {})[:users],
      trusted_bots: trusted_payload.fetch(:counts, {})[:bots],
      trusted_metadata_bots: trusted_payload.fetch(:counts, {})[:metadata_bots],
      trusted_teams: trusted_payload.fetch(:counts, {})[:teams],
      trusted_unique: trusted.length,
      refresh_status: blockers.empty? ? "ok" : "blocked"
    },
    outside_activity_count: items.length,
    diagnostic: diagnostic,
    state_read: state_read,
    state_updated: state_updated,
    slack_sent: slack_sent,
    slack_error: slack_error,
    blockers: blockers,
    items: items
  }

  if blockers.any?
    blockers << "scan status: state not advanced" unless state_updated
    begin
      post_slack(build_blocked_message(blockers, start_time, ended_at)) unless diagnostic
      result[:slack_sent] = !diagnostic
    rescue StandardError => e
      result[:slack_error] = e.message unless slack_error
      slack_error ||= e.message
    end
  end

  status_label = if blockers.empty? && items.empty?
    "OUTSIDE ACTIVITY: ZERO"
  else
    "OUTSIDE ACTIVITY: ATTENTION"
  end
  scan_completed = blockers.empty? && (diagnostic || !items.any? || slack_sent)
  result[:result_status] = scan_completed ? "completed" : "attention_needed"
  result[:result_summary] = if blockers.empty? && items.empty?
    "No new outside activity found in scan window."
  elsif blockers.empty?
    "Outside activity detected: #{items.length} item(s) found."
  else
    "Scan blocked or incomplete: review blockers and rerun."
  end
  result[:result_status_label] = status_label

  safe_write(RESULT_PATH, result)
  puts status_label
  puts result[:result_summary]
  puts JSON.pretty_generate(result)
  puts status_label

  if blockers.any? || (!diagnostic && items.any? && !slack_sent)
    exit 2
  else
    exit 0
  end
end

run if $PROGRAM_NAME == __FILE__
